#version 460
// Modified in WinlatorMali: ZFG_SPLIT_A/B (split resolve), ZFG_FIELD_TEX, ZFG_FIXED, ZFG_CR5_HALF, ZFG_SONE_GAIN and the Mali register trims; the zero-vector candidate in the fixed form and the one-sided warp at the picture edge.
#extension GL_GOOGLE_include_directive : require
// SPLIT form (Mali): the alternatives make the kernel twice the registers of the rest (53 against 32 on a Mali-G615, half
// the occupancy for every pixel), while only the pixels whose base candidate disagrees by more than `margin` evaluate them.
//   ZFG_SPLIT_A  every pixel, without the alternatives; a pixel that would evaluate them is appended to a list (binding 9)
//                and its count (binding 10) sizes the indirect dispatch of the second pass.
//   ZFG_SPLIT_B  the listed pixels only, with the whole kernel (it overwrites what A wrote there).
// A pixel that is not listed would not have evaluated the alternatives, and a listed one runs the full kernel: the picture is
// the one-pass picture word for word.
#if defined(ZFG_SPLIT_A) || defined(ZFG_SPLIT_B)
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#endif
// D5 Resolve.
//   mode 0  the RC1 Generate: the whole image is one class; each pixel blends the four surrounding
//           cells' motions with the RC1 confidence and agreement weights and warps A and B with the
//           sampler's bilinear filter.
//   mode 1  the bridge: the RC1 result is candidate 0. Alternatives (`cand` bit mask): 1 = the H0 of
//           the four surrounding cells (the VMC parents), 2 = their H1, 4 = the zero vector. The
//           alternative whose two warps agree best (the smallest difference between A and B at the
//           pixel, the VMC rule) replaces candidate 0 only if it wins by `margin` (a preference for
//           the smooth RC1 field, so cells that agree do not stair-step) and its own difference is
//           under `error_cap` (a vector that does not even agree with itself is not an answer: a
//           scene cut or an ambiguous pattern then keeps the RC1 behaviour).
// `trust_mode` is how far a warp is trusted against the held picture B: 0 is the RC1 rule (field
// confidence times photometric agreement: a good field is thrown away wherever the two warps disagree),
// 1 trusts the warp when EITHER the field or the photometric evidence is high (the RC2 "veto max"
// rule, with the photometric term softened by smoothstep(0.02, 0.35)).
// The tile lists, the smooth4 hardware-filtered fetch, the geometry and the detail resolves and the
// pixel guard of the spec (section 8) replace this in later steps.
#include "rc3_common.glsl"

layout(constant_id = 0) const int ZFG_MODE = 0;
// The kernel of the FINAL colour (the decisions below always use the sampler's bilinear taps, as the core's F1 does):
//   0 bilinear (the colour of the decision taps), 1 Catmull-Rom from nine bilinear taps (the Compat form of the sharp
//   kernel), 2 Catmull-Rom from five taps (renormalised), 3 the hardware cubic sampler (VK_EXT_filter_cubic, the Modern
//   form; away from the picture border, Catmull-Rom nine taps there). Every kernel is clamped to the range of the 2 x 2
//   texels around the sample, so a hard edge cannot ring. The colour is resampled ONCE, at the pixel's final decision.
#ifdef ZFG_SHARP_FORCE
const int ZFG_SHARP = ZFG_SHARP_FORCE;  // a kernel chosen at build time (the host's constant 26 is then ignored)
#else
layout(constant_id = 26) const int ZFG_SHARP = 0;
#endif
layout(constant_id = 32) const int ZFG_LAYER = 0;   // EXPERIMENT: a screen-space persistent layer (the same high-frequency structure at the same pixel in A and B) keeps the still colour
layout(constant_id = 33) const int ZFG_LYWORLD = 0; // EXPERIMENT (lyw=1): the layer yields where the warp's own motion explains what A and B show at the pixel (the world hypothesis)
layout(constant_id = 34) const int ZFG_FBUNK = 0;   // EXPERIMENT (fbunk=1): with fb=4, a pair whose A-B correlation could not be measured blends like a continuous one
// EXPERIMENT (soft=N, thousandths): the alternative does not replace the base candidate in one step at `margin` but over a ramp of half width N/1000 around it,
// the two (sharp) warps mixed in between: the decision boundary between neighbouring vectors becomes a blend instead of a pixel-to-pixel switch (the two-
// hypothesis form of an exponentially weighted combination of warp hypotheses). 0 = the hard rule, word for word.
layout(constant_id = 35) const int ZFG_SOFT = 0;
layout(constant_id = 36) const int ZFG_GREL = 0;    // the relative guard: per mille of the informative cells that must beat half of their own texture (0 = the absolute share only)
layout(constant_id = 37) const int ZFG_GINFO = 150;  // ... and the per mille of the cells that must be informative for that test to count
layout(constant_id = 31) const int ZFG_STATIC = 0;  // 1 = a pixel that is the same in A and B and has structure around it, but whose output the warp changed, stays the still colour (a static overlay: text, a HUD)
layout(constant_id = 30) const int ZFG_PHOTO = 0;  // 1 = the photometric agreement of the two warps reads A at B's exposure (d0p_photo.comp)
layout(constant_id = 29) const int ZFG_FB = 0;       // EXPERIMENT: the untrusted pixel shows 1 the blend of A and B, 2 the blend only where one of the two is dark (instead of the held B)
layout(constant_id = 28) const int ZFG_SDETAIL = 0;  // EXPERIMENT: the sharp colour is blended with the bilinear one by how well the two warps agree: 1 over a 0.02..0.15 photometric error, 2 over 0.06..0.30
#ifndef ZFG_SONE_GAIN
#define ZFG_SONE_GAIN 1.0
#endif
#ifdef ZFG_SONE_FORCE
const int ZFG_SONE = ZFG_SONE_FORCE;
#else
layout(constant_id = 39) const int ZFG_SONE = 0;
#endif    // EXPERIMENT (sone=1|2): the sharp detail of ONE source (1: B, 2: A) added to the bilinear blend of the two warps (half the sharp fetches; not the same picture)
layout(constant_id = 27) const int ZFG_SGUARD = 1;  // 1 = the nine-tap and hardware kernels are clamped to the 2 x 2 texel range (4 more fetches per source); 0 = unguarded

#ifdef ZFG_SPLIT_B
layout(local_size_x = 64, local_size_y = 1) in;
#else
layout(local_size_x = 8, local_size_y = 8) in;
#endif

#if defined(ZFG_SPLIT_A) || defined(ZFG_SPLIT_B)
layout(std430, binding = 9) buffer SplitList {
  uint split_list[];  // the pixels of the second pass, x | y << 16
};
layout(std430, binding = 10) buffer SplitArgs {
  uint split_count;
  uint split_groups_x;  // the indirect dispatch (x, 1, 1) of the second pass, 64 pixels per workgroup
  uint split_groups_y;
  uint split_groups_z;
};
#endif

layout(binding = 0) uniform sampler2D source_a;
layout(binding = 1) uniform sampler2D source_b;
layout(binding = 6) uniform sampler2D cubic_a;  // the same images through a VK_FILTER_CUBIC_EXT sampler (sharp = 3)
layout(binding = 7) uniform sampler2D cubic_b;
layout(std430, binding = 2) readonly buffer CellField {
  vec4 cell_field[];
};
layout(rgb10_a2, binding = 3) uniform writeonly image2D output_image;
layout(std430, binding = 4) readonly buffer CellAlt {
  vec4 cell_alt[];  // H1 of the cell: motion, confidence, valid
};
layout(std430, binding = 5) buffer Counters {
  uint counters[];
};
layout(std430, binding = 8) readonly buffer Photo {
  vec4 photo;  // gain, bias of A onto B (the identity when no exposure change was found)
  vec4 stats;  // x: the correlation of A and B (1 = a continuous pair, near 0 = a scene cut); y: 1 when it was measured (0: no spread to measure it on);
               // z: the texture ratio sigma_min / sigma_max of A and B (-1 when neither is clearly textured)
  vec4 chroma;  // the gain of each colour channel relative to the luma gain (1, 1, 1 = none)
};

layout(push_constant) uniform ResolvePush {
  ivec2 source_extent;
  ivec2 active_origin;
  ivec2 active_extent;
  ivec2 output_extent;
  ivec2 field_extent;
  float phase;
  float margin;     // an alternative must beat the RC1 candidate's A/B difference by this much
  float error_cap;  // and its own A/B difference must be under this
  int cand;         // bit mask of the alternatives: 1 parents (H0), 2 H1, 4 zero
  int trust_mode;   // 0 RC1 product, 1 max of field and photometric evidence
  float guard;      // pair guard: when fewer than this share of the cells matched, hold B (0 = off)
  int early;        // 1 = skip the alternatives of a pixel whose base candidate already agrees to within `margin` (exact)
  float fb_low;     // fb=3: the coverage at which the blend starts to show
  float fb_high;    // ... and at which it is fully shown
  float st_eps;     // zstatic: A and B agree at the pixel (and on its four neighbours at 2 px) to within this ...
  float st_delta;   // ... the warp's colour is farther than this from the still colour ...
  float st_grad;    // ... and the still picture has at least this much structure around the pixel (flat or dark areas are not overlays)
  float ly_mag;     // layer: the luma gradient (per ly_off px) both A and B must have at the pixel ...
  float ly_cos;     // ... the cosine of their gradient directions from which the structure counts as the same ...
  float ly_away;    // ... and the colour the warp moved the pixel from the still one by more than this ...
  float ly_off;     // ... gradients by central differences at +-ly_off px
  float flat_lo;    // trust_mode 3: a photometric error under this is an exact agreement (a flat area), whatever the vector ...
  float flat_hi;    // ... and over this it can be luck
  float amb_floor;  // trust_mode 2: the share of the photometric rescue that a cell with no unique vector keeps (1 = all, as mode 1)
  int st_n;         // zstatic: at least this many of the four neighbours (at 2 px) must also be the same in A and B (0 = the pixel alone)
  float guard_corr; // pair guard: a pair whose measured A-B correlation is at least this is not a cut, whatever its match costs (an exposure change)
  float guard_flat; // pair guard: a texture ratio under this makes the match fraction no evidence (0 = off)
} pc;

// The product's values of three switches, as constants (ZFG_FIXED): the compiler then drops the disabled alternatives and
// trust modes and their registers. The same values as the push constants the host sends, so the picture is the same.
#ifdef ZFG_FIXED
// The parents and the zero vector: a static overlay (HUD text, a minimap, subtitles) over a moving scene keeps its place,
// where the scene's motion would drag it along (the zero vector wins only where it agrees by the margin).
#define PC_CAND 5
#define PC_TRUST_MODE 3
#define PC_EARLY 1
#else
#define PC_CAND pc.cand
#define PC_TRUST_MODE pc.trust_mode
#define PC_EARLY pc.early
#endif

#ifdef ZFG_FIELD_TEX
// The same cells as an image (a copy the host makes after D3): the texture unit fetches them, and the load/store unit (this
// kernel's bottleneck on a Mali-G615) only stores the pixel. The same 32-bit values, so the picture is the same.
layout(binding = 11) uniform sampler2D cell_field_texels;
#endif

vec4 ReadField(ivec2 p) {
  p = clamp(p, ivec2(0), pc.field_extent - ivec2(1));
#ifdef ZFG_FIELD_TEX
  return texelFetch(cell_field_texels, p, 0);
#else
  return cell_field[p.y * pc.field_extent.x + p.x];
#endif
}

vec4 ReadAlt(ivec2 p) {
  p = clamp(p, ivec2(0), pc.field_extent - ivec2(1));
  return cell_alt[p.y * pc.field_extent.x + p.x];
}

hvec4 SampleActive(sampler2D image_sampler, vec2 local_position) {
  vec2 half_texel = 0.5 / vec2(pc.active_extent);
  vec2 safe_position = clamp(local_position, half_texel,
                             vec2(1.0) - half_texel);
  vec2 source_pixel = vec2(pc.active_origin) +
      safe_position * vec2(pc.active_extent);
  return hvec4(textureLod(image_sampler,
                          source_pixel / vec2(pc.source_extent), 0.0));
}

// Catmull-Rom as nine bilinear taps (the core's RC1 Test F1 kernel, generate_motion_policy.comp): three taps per axis
// whose weights are the kernel's, the two middle texels merged into one tap placed by the ratio of their weights.
struct CatmullRomTaps {
  vec2 source_pixel;
  vec2 p0, p12, p3;
  vec2 w0, w12, w3;
};

CatmullRomTaps CatmullRomSetup(vec2 local_position) {
  CatmullRomTaps taps;
  vec2 half_texel = 0.5 / vec2(pc.active_extent);
  vec2 safe_position = clamp(local_position, half_texel, vec2(1.0) - half_texel);
  vec2 origin = vec2(pc.active_origin);
  taps.source_pixel = origin + safe_position * vec2(pc.active_extent);
  vec2 centre1 = floor(taps.source_pixel - 0.5) + 0.5;
  vec2 f = taps.source_pixel - centre1;
  taps.w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
  vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
  vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
  taps.w3 = f * f * (-0.5 + 0.5 * f);
  taps.w12 = w1 + w2;
  vec2 low = origin + 0.5;
  vec2 high = origin + vec2(pc.active_extent) - 0.5;
  vec2 inverse_extent = 1.0 / vec2(pc.source_extent);
  taps.p0 = clamp(centre1 - 1.0, low, high) * inverse_extent;
  taps.p12 = clamp(centre1 + w2 / taps.w12, low, high) * inverse_extent;
  taps.p3 = clamp(centre1 + 2.0, low, high) * inverse_extent;
  return taps;
}

// The range of the 2 x 2 texels around the sample point: the ringing guard of every sharp kernel.
void CornerRange(sampler2D image_sampler, vec2 source_pixel, out vec4 low, out vec4 high) {
  ivec2 base = ivec2(floor(source_pixel - 0.5));
  ivec2 first = pc.active_origin;
  ivec2 last = pc.active_origin + pc.active_extent - ivec2(1);
  vec4 t00 = texelFetch(image_sampler, clamp(base, first, last), 0);
  vec4 t10 = texelFetch(image_sampler, clamp(base + ivec2(1, 0), first, last), 0);
  vec4 t01 = texelFetch(image_sampler, clamp(base + ivec2(0, 1), first, last), 0);
  vec4 t11 = texelFetch(image_sampler, clamp(base + ivec2(1, 1), first, last), 0);
  low = min(min(t00, t10), min(t01, t11));
  high = max(max(t00, t10), max(t01, t11));
}

vec4 CatmullRom9(sampler2D image_sampler, vec2 local_position) {
  CatmullRomTaps t = CatmullRomSetup(local_position);
  vec4 result =
      (textureLod(image_sampler, vec2(t.p0.x, t.p0.y), 0.0) * t.w0.x +
       textureLod(image_sampler, vec2(t.p12.x, t.p0.y), 0.0) * t.w12.x +
       textureLod(image_sampler, vec2(t.p3.x, t.p0.y), 0.0) * t.w3.x) * t.w0.y +
      (textureLod(image_sampler, vec2(t.p0.x, t.p12.y), 0.0) * t.w0.x +
       textureLod(image_sampler, vec2(t.p12.x, t.p12.y), 0.0) * t.w12.x +
       textureLod(image_sampler, vec2(t.p3.x, t.p12.y), 0.0) * t.w3.x) * t.w12.y +
      (textureLod(image_sampler, vec2(t.p0.x, t.p3.y), 0.0) * t.w0.x +
       textureLod(image_sampler, vec2(t.p12.x, t.p3.y), 0.0) * t.w12.x +
       textureLod(image_sampler, vec2(t.p3.x, t.p3.y), 0.0) * t.w3.x) * t.w3.y;
  if (ZFG_SGUARD == 0) {
    return result;
  }
  vec4 low, high;
  CornerRange(image_sampler, t.source_pixel, low, high);
  return clamp(result, low, high);
}

// The five-tap form (the four corner taps carry products of two negative lobes, well under 1 % of the weight): the
// ringing guard is the range of the five taps themselves.
#ifdef ZFG_CR5_HALF
// The five-tap kernel with its taps and weights in half precision (the taps are 8-bit colours): half the registers.
vec4 CatmullRom5(sampler2D image_sampler, vec2 local_position) {
  CatmullRomTaps t = CatmullRomSetup(local_position);
  half weight_top = half(t.w12.x * t.w0.y);
  half weight_left = half(t.w0.x * t.w12.y);
  half weight_middle = half(t.w12.x * t.w12.y);
  half weight_right = half(t.w3.x * t.w12.y);
  half weight_bottom = half(t.w12.x * t.w3.y);
  hvec4 top = hvec4(textureLod(image_sampler, vec2(t.p12.x, t.p0.y), 0.0));
  hvec4 left = hvec4(textureLod(image_sampler, vec2(t.p0.x, t.p12.y), 0.0));
  hvec4 middle = hvec4(textureLod(image_sampler, vec2(t.p12.x, t.p12.y), 0.0));
  hvec4 right = hvec4(textureLod(image_sampler, vec2(t.p3.x, t.p12.y), 0.0));
  hvec4 bottom = hvec4(textureLod(image_sampler, vec2(t.p12.x, t.p3.y), 0.0));
  hvec4 result = (top * weight_top + left * weight_left + middle * weight_middle + right * weight_right +
                  bottom * weight_bottom) /
      (weight_top + weight_left + weight_middle + weight_right + weight_bottom);
  hvec4 low = min(min(min(top, left), min(middle, right)), bottom);
  hvec4 high = max(max(max(top, left), max(middle, right)), bottom);
  return vec4(clamp(result, low, high));
}
#else
vec4 CatmullRom5(sampler2D image_sampler, vec2 local_position) {
  CatmullRomTaps t = CatmullRomSetup(local_position);
  float weight_top = t.w12.x * t.w0.y;
  float weight_left = t.w0.x * t.w12.y;
  float weight_middle = t.w12.x * t.w12.y;
  float weight_right = t.w3.x * t.w12.y;
  float weight_bottom = t.w12.x * t.w3.y;
  vec4 top = textureLod(image_sampler, vec2(t.p12.x, t.p0.y), 0.0);
  vec4 left = textureLod(image_sampler, vec2(t.p0.x, t.p12.y), 0.0);
  vec4 middle = textureLod(image_sampler, vec2(t.p12.x, t.p12.y), 0.0);
  vec4 right = textureLod(image_sampler, vec2(t.p3.x, t.p12.y), 0.0);
  vec4 bottom = textureLod(image_sampler, vec2(t.p12.x, t.p3.y), 0.0);
  vec4 result = (top * weight_top + left * weight_left + middle * weight_middle + right * weight_right +
                 bottom * weight_bottom) /
      (weight_top + weight_left + weight_middle + weight_right + weight_bottom);
  vec4 low = min(min(min(top, left), min(middle, right)), bottom);
  vec4 high = max(max(max(top, left), max(middle, right)), bottom);
  return clamp(result, low, high);
}
#endif

// The hardware cubic fetch, used where its whole 4 x 4 footprint is inside the active rect (the sampler's border rule
// would differ from the clamped taps of the shader form there); the guard is the same 2 x 2 range.
vec4 HardwareCubic(sampler2D image_sampler, sampler2D cubic_sampler, vec2 local_position) {
  vec2 half_texel = 0.5 / vec2(pc.active_extent);
  vec2 safe_position = clamp(local_position, half_texel, vec2(1.0) - half_texel);
  vec2 source_pixel = vec2(pc.active_origin) + safe_position * vec2(pc.active_extent);
  vec2 relative = source_pixel - vec2(pc.active_origin);
  ivec2 base = ivec2(floor(source_pixel - 0.5));
  bool interior = all(greaterThanEqual(relative, vec2(2.5))) &&
      all(lessThanEqual(relative, vec2(pc.active_extent) - 2.5)) &&
      all(greaterThanEqual(base - ivec2(1), pc.active_origin)) &&
      all(lessThanEqual(base + ivec2(2), pc.active_origin + pc.active_extent - ivec2(1)));
  if (!interior) {
    return CatmullRom9(image_sampler, local_position);
  }
  vec4 result = textureLod(cubic_sampler, source_pixel / vec2(pc.source_extent), 0.0);
  if (ZFG_SGUARD == 0) {
    return result;
  }
  vec4 low, high;
  CornerRange(image_sampler, source_pixel, low, high);
  return clamp(result, low, high);
}

hvec4 SampleSharpA(vec2 local_position) {
  if (ZFG_SHARP == 1) return hvec4(CatmullRom9(source_a, local_position));
  if (ZFG_SHARP == 2) return hvec4(CatmullRom5(source_a, local_position));
  return hvec4(HardwareCubic(source_a, cubic_a, local_position));
}

hvec4 SampleSharpB(vec2 local_position) {
  if (ZFG_SHARP == 1) return hvec4(CatmullRom9(source_b, local_position));
  if (ZFG_SHARP == 2) return hvec4(CatmullRom5(source_b, local_position));
  return hvec4(HardwareCubic(source_b, cubic_b, local_position));
}

half WarpTrust(half field_trust, half photo_error, half uniqueness) {
  if (ZFG_MODE == 0 || PC_TRUST_MODE == 0) {
    return field_trust * clamp(half(1.0) - photo_error, half(0.0), half(1.0));
  }
  half rescue = half(1.0) - smoothstep(half(0.02), half(0.35), photo_error);
  if (PC_TRUST_MODE == 2) {
    // The photometric rescue of a cell whose best vector is not unique (a periodic texture: the aliased vector agrees photometrically too) counts less.
    rescue *= half(pc.amb_floor) + (half(1.0) - half(pc.amb_floor)) * uniqueness;
  }
  if (PC_TRUST_MODE == 3) {
    // A vector whose field has (almost) no confidence is not rescued by an accidental photometric agreement: where nothing matches (a cape that
    // deforms under the camera), the agreement of two warps of a periodic or noisy texture is luck, and trusting it paints a mosaic of the cell grid.
    // A flat area (the two warps agree to within a hair: any vector gives the same colour) is not a luck of the draw and keeps its rescue.
    half lucky = smoothstep(half(pc.flat_lo), half(pc.flat_hi), photo_error);
    rescue *= mix(half(1.0), smoothstep(half(0.25) * half(pc.amb_floor), half(pc.amb_floor), field_trust), lucky);
  }
  return max(field_trust, rescue);
}

// A's colour at B's exposure, for the AGREEMENT test only (a fade is not a motion error): the output colour is the two pictures as they are.
hvec3 AtBExposure(hvec3 color_a) {
  return ZFG_PHOTO != 0 ? clamp(color_a * (half(photo.x) * hvec3(chroma.xyz)) + half(photo.y), half(0.0), half(1.0)) : color_a;
}

bool GeometricallyValid(vec2 p) {
  return all(greaterThanEqual(p, vec2(0.0))) &&
      all(lessThanEqual(p, vec2(1.0)));
}

// Tile modes use one-pixel in-tile differences; layer 5 also uses that spacing for the halo (the parser requires ly_off == 1).
// layer = 4: the luma of A and of B of the 8 x 8 workgroup, so that a pixel reads its neighbours' values (the gradients of the persistent-layer test) from
// shared memory: no fetch at all (the pixel's own A and B are in hand already).
shared float tile_a[64];
shared float tile_b[64];

// The gradient of a tile at the local pixel (luma per pixel): central differences inside the tile, one-sided on its edge. (Two functions on the shared arrays,
// not one that takes the array: a shared array passed by value is copied.)
vec2 TileGradientA(ivec2 l) {
  int index = l.y * 8 + l.x;
  int xp = l.x < 7 ? 1 : 0, xm = l.x > 0 ? 1 : 0, yp = l.y < 7 ? 8 : 0, ym = l.y > 0 ? 8 : 0;
  return vec2((tile_a[index + xp] - tile_a[index - xm]) / float(max(1, xp + xm)), (tile_a[index + yp] - tile_a[index - ym]) / float(max(1, (yp + ym) / 8)));
}

vec2 TileGradientB(ivec2 l) {
  int index = l.y * 8 + l.x;
  int xp = l.x < 7 ? 1 : 0, xm = l.x > 0 ? 1 : 0, yp = l.y < 7 ? 8 : 0, ym = l.y > 0 ? 8 : 0;
  return vec2((tile_b[index + xp] - tile_b[index - xm]) / float(max(1, xp + xm)), (tile_b[index + yp] - tile_b[index - ym]) / float(max(1, (yp + ym) / 8)));
}

void main() {
#ifdef ZFG_SPLIT_B
  if (gl_GlobalInvocationID.x >= split_count) {
    return;
  }
  const uint listed = split_list[gl_GlobalInvocationID.x];
  ivec2 output_coordinate = ivec2(int(listed & 0xFFFFu), int(listed >> 16));
#else
  ivec2 output_coordinate = ivec2(gl_GlobalInvocationID.xy);
#endif
  const bool inside = all(lessThan(output_coordinate, pc.output_extent));
  if (ZFG_LAYER < 4 && !inside) {
    return;
  }
