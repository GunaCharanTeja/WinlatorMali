        gb = 0.5 * vec2(bxp - bxm, byp - bym);
      } else if (ZFG_LAYER == 3) {
        // Forward differences: the pixel's own colours are already in hand, so a gradient costs two new fetches per source.
        float la = dot(vec3(here_a.rgb), w709), lb = dot(vec3(here_b.rgb), w709);
        ga = vec2(dot(vec3(SampleActive(source_a, at_xp).rgb), w709) - la, dot(vec3(SampleActive(source_a, at_yp).rgb), w709) - la);
        gb = vec2(dot(vec3(SampleActive(source_b, at_xp).rgb), w709) - lb, dot(vec3(SampleActive(source_b, at_yp).rgb), w709) - lb);
      } else {
        float ax1 = dot(vec3(SampleActive(source_a, at_xp).rgb), w709), ax0 = dot(vec3(SampleActive(source_a, at_xm).rgb), w709);
        float ay1 = dot(vec3(SampleActive(source_a, at_yp).rgb), w709), ay0 = dot(vec3(SampleActive(source_a, at_ym).rgb), w709);
        float bx1 = dot(vec3(SampleActive(source_b, at_xp).rgb), w709), bx0 = dot(vec3(SampleActive(source_b, at_xm).rgb), w709);
        float by1 = dot(vec3(SampleActive(source_b, at_yp).rgb), w709), by0 = dot(vec3(SampleActive(source_b, at_ym).rgb), w709);
        ga = 0.5 * vec2(ax1 - ax0, ay1 - ay0);
        gb = 0.5 * vec2(bx1 - bx0, by1 - by0);
      }
      float ma2 = dot(ga, ga), mb2 = dot(gb, gb);
      // An edge in both pictures or nothing (squared magnitudes: no root, no division for the pixels that are not edges, which are most of them).
      if (min(ma2, mb2) > pc.ly_mag * pc.ly_mag) {
      float ma = sqrt(ma2), mb = sqrt(mb2);
      float strong = smoothstep(pc.ly_mag, 2.5 * pc.ly_mag, min(ma, mb));
      float aligned = smoothstep(pc.ly_cos, min(1.0, pc.ly_cos + 0.25), dot(ga, gb) / (ma * mb));
      float alike = smoothstep(0.3, 0.6, min(ma, mb) / max(ma, mb));
      float moved = smoothstep(float(pc.ly_away), 3.0 * float(pc.ly_away), float(away));
      float layer_weight = strong * aligned * alike * moved;
      if (ZFG_LYWORLD != 0 && layer_weight > 0.0 && final_warp) {
        // The dispute of the two hypotheses. The structure persists at the pixel in A and B: either a layer holds it there (a HUD), or the world moved by
        // the warp's vector v and the persistence is a coincidence of the world's texture (a period that divides v, an edge that moves along itself).
        // Under the world hypothesis B shows at the pixel the world point that A shows at p - v, and A the one that B shows at p + v. Where both agree (to
        // within the scale at which the output counts as moved), the world's motion explains the pixel and the warp stays; where either does not, the
        // structure is the layer's. A side whose world point lies outside the picture says nothing (a clamped sample is not the world point); with neither
        // side inside, the layer keeps its verdict. (With sharp=0 the vector is the base candidate's even when an alternative won.)
        vec2 v = final_t_b - final_t_a;
        float unexplained = 0.0;
        bool witnessed = false;
        if (GeometricallyValid(t - v)) {
          hvec3 world_b = abs(AtBExposure(SampleActive(source_a, t - v).rgb) - here_b.rgb);
          unexplained = float(max(world_b.r, max(world_b.g, world_b.b)));
          witnessed = true;
        }
        if (GeometricallyValid(t + v)) {
          hvec3 world_a = abs(AtBExposure(here_a.rgb) - SampleActive(source_b, t + v).rgb);
          unexplained = max(unexplained, float(max(world_a.r, max(world_a.g, world_a.b))));
          witnessed = true;
        }
        if (witnessed) {
          // (Measured 2026-10-06: the same test relative to the warp's own disagreement at p -+ v/2 kept less of the HUD and protected the world less.)
          layer_weight *= smoothstep(float(pc.ly_away), 3.0 * float(pc.ly_away), unexplained);
        }
      }
      if (layer_weight > 0.0) ZFG_COUNT(kCtrD5LayerApplied);
      result = mix(result, half(0.5) * (here_a + here_b), half(layer_weight));
      }
    }
  }
  if (inside) {
    imageStore(output_image, output_coordinate, vec4(result));
  }
}
