<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/LLContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="0dp">

    <!-- ========================================================= -->
    <!-- PINNED TOP NAVIGATION TAB BAR                             -->
    <!-- ========================================================= -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/TabLayout"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/tab_layout_background"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabIndicatorColor="?attr/colorAccent"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="false"
        app:tabTextColor="?attr/semanticOnSurface"
        app:tabSelectedTextColor="?attr/semanticOnSurface"
        android:layout_marginBottom="10dp">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/general" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/win_components" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/environment_variables" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/advanced" />
    </com.google.android.material.tabs.TabLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========================================================= -->
            <!-- TAB 0: GENERAL (Display, Graphics, Audio, Emulation)       -->
            <!-- ========================================================= -->
            <LinearLayout
                android:id="@+id/LLTabGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- CARD 1: GENERAL & DISPLAY                                 -->
                <!-- ========================================================= -->
                <TextView
                    android:id="@+id/TVGeneralDisplay"
            android:tag="section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="General &amp; Display"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?attr/colorAccent"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/name"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                style="@style/AppTheme"
                android:id="@+id/ETName"
                android:inputType="textCapSentences"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/screen_size"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <Spinner
                    style="@style/ComboBox"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:id="@+id/SScreenSize"
                    android:entries="@array/screen_size_entries"
                    android:spinnerMode="dropdown" />

                <LinearLayout
                    android:id="@+id/LLCustomScreenSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="8dp"
                    android:visibility="gone">

                    <EditText
                        style="@style/AppTheme"
                        android:layout_width="64dp"
                        android:layout_height="42dp"
                        android:id="@+id/ETScreenWidth"
                        android:gravity="center"
                        android:inputType="number" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="x" />

                    <EditText
                        style="@style/AppTheme"
                        android:layout_width="64dp"
                        android:layout_height="42dp"
                        android:id="@+id/ETScreenHeight"
                        android:gravity="center"
                        android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/CBFullscreenStretched"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fullscreen_stretched"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ========================================================= -->
        <!-- CARD 2: GRAPHICS & RENDERING                              -->
        <!-- ========================================================= -->
        <TextView
            android:id="@+id/TVGraphicsRendering"
            android:tag="section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Graphics &amp; Rendering"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?attr/colorAccent"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Display Driver"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <Spinner
                    style="@style/ComboBox"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:id="@+id/SDisplayDriver"
                    android:entries="@array/display_driver_entries" />

                <ImageButton
                    style="@style/ListMenuButton"
                    android:id="@+id/BTDisplayDriverConfig"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:padding="6dp"
                    app:tint="?attr/colorAccent"
                    android:src="@drawable/icon_settings"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/graphics_driver"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <Spinner
                    style="@style/ComboBox"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:id="@+id/SGraphicsDriver"
                    android:entries="@array/graphics_driver_entries" />

                <ImageButton
                    style="@style/ListMenuButton"
                    android:id="@+id/BTGraphicsDriverConfig"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:padding="6dp"
                    app:tint="?attr/colorAccent"
                    android:src="@drawable/icon_settings"
                    android:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/TVWrapperVersionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Version:"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="?attr/semanticOnSurfaceVariant"
                    android:paddingEnd="6dp" />

                <TextView
                    android:id="@+id/TVGraphicsDriverVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="default_version"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorAccent" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dxwrapper"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/BTHelpDXWrapper"
                    style="@style/HelpButton"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <Spinner
                    style="@style/ComboBox"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:id="@+id/SDXWrapper"
                    android:entries="@array/dxwrapper_entries"
                    android:spinnerMode="dropdown" />

                <ImageButton
                    style="@style/ListMenuButton"
                    android:id="@+id/BTDXWrapperConfig"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:padding="6dp"
                    app:tint="?attr/colorAccent"
                    android:src="@drawable/icon_settings"
                    android:visibility="visible" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bcn_layer_configuration"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:id="@+id/LLBCNConfigRow"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bordered_panel_dark"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Configure BCN Texture Layer"
                    android:textSize="14sp"
                    android:textColor="?attr/semanticOnSurface" />

                <ImageButton
                    style="@style/ListMenuButton"
                    android:id="@+id/BTBCNConfig"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:padding="6dp"
                    app:tint="?attr/colorAccent"
                    android:src="@drawable/icon_settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========================================================= -->
        <!-- CARD 3: SYSTEM & AUDIO                                    -->
        <!-- ========================================================= -->
        <TextView
            android:id="@+id/TVSystemAudio"
            android:tag="section_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="System &amp; Audio"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="?attr/colorAccent"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:padding="14dp"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/audio_driver"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:id="@+id/SAudioDriver"
                android:entries="@array/audio_driver_entries"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:id="@+id/LLEmulator">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="64bit Emulator"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:id="@+id/SEmulator64"
                    android:entries="@array/emulator_entries"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dll_emulator"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:id="@+id/SEmulator"
                    android:entries="@array/emulator_entries"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/midi_sound_font"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <Spinner
                style="@style/ComboBox"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:id="@+id/SMIDISoundFont"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lc_all"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    style="@style/AppTheme"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:id="@+id/ETlcall" />

                <ImageButton
                    style="@style/ListMenuButton"
                    android:id="@+id/BTShowLCALL"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="8dp"
                    android:padding="6dp"
                    app:tint="?attr/colorAccent"
                    android:src="@drawable/icon_menu" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

        <!-- ========================================================= -->
        <!-- TAB 1: WIN COMPONENTS                                     -->
        <!-- ========================================================= -->
        <LinearLayout
            android:id="@+id/LLTabWinComponents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/TVDirectX"
                android:tag="section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/directx"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?attr/colorAccent"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/LLWinComponentsDirectX"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bordered_panel_dark"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/TVGeneral"
                android:tag="section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/general"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?attr/colorAccent"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/LLWinComponentsGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bordered_panel_dark"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <!-- TAB 2: Environment Variables -->
        <LinearLayout
            android:id="@+id/LLTabEnvVars"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bordered_panel_dark"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <com.winlator.cmod.widget.EnvVarsView
                    android:id="@+id/EnvVarsView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View style="@style/HorizontalLine" />

                <Button
                    style="@style/ButtonNeutral"
                    android:id="@+id/BTAddEnvVar"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/add" />
            </LinearLayout>
        </LinearLayout>

        <!-- TAB 3: Advanced -->
        <LinearLayout
            android:id="@+id/LLTabAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/box64Frame">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/TVBox64"
                        android:tag="section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/box64"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorAccent"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bordered_panel_dark"
                        android:padding="14dp"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/box64_version"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SBox64Version"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:entries="@array/box64_version_entries"
                            android:spinnerMode="dropdown"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/box64_preset"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SBox64Preset"
                            android:layout_width="match_parent"
                            android:layout_height="42dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/fexcoreFrame">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/TVFEXCore"
                        android:tag="section_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/fexcore_config"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorAccent"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bordered_panel_dark"
                        android:padding="14dp"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fexcore_version"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SFEXCoreVersion"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fexcore_preset"
                            android:textSize="13sp"
                            android:layout_marginBottom="4dp" />

                        <Spinner
                            style="@style/ComboBox"
                            android:id="@+id/SFEXCorePreset"
                            android:layout_width="match_parent"
                            android:layout_height="42dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/TVSystem"
                android:tag="section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/system"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?attr/colorAccent"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bordered_panel_dark"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/startup_selection"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    style="@style/ComboBox"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:id="@+id/SStartupSelection"
                    android:entries="@array/startup_selection_entries" />
            </LinearLayout>

            <TextView
                android:id="@+id/TVInputControls"
                android:tag="section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/input_controls"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?attr/colorAccent"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bordered_panel_dark"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    style="@style/ComboBox"
                    android:id="@+id/SControlsProfile"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:spinnerMode="dropdown"
                    android:layout_marginBottom="12dp" />

                <CheckBox
                    android:id="@+id/CBDisabledXInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/disable_xinput_for_shortcut"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <CheckBox
                    android:id="@+id/CBTouchscreenMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/simulate_touch_screen"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/TVLaunchArgs"
                android:tag="section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Launch Arguments &amp; Optimizations"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?attr/colorAccent"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bordered_panel_dark"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exec_arguments"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <EditText
                        style="@style/AppTheme"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:id="@+id/ETExecArgs" />

                    <ImageButton
                        style="@style/ListMenuButton"
                        android:id="@+id/BTExtraArgsMenu"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:padding="6dp"
                        app:tint="?attr/colorAccent"
                        android:src="@drawable/icon_menu" />
                </LinearLayout>


            </LinearLayout>



            <TextView
                android:id="@+id/TVProcessorAffinity"
                android:tag="section_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/processor_affinity"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="?attr/colorAccent"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bordered_panel_dark"
                android:padding="14dp"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <com.winlator.cmod.widget.CPUListView
                    android:id="@+id/CPUListView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
</LinearLayout>
