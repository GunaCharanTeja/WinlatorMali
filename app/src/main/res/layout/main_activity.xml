<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/DrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <LinearLayout
        android:id="@+id/consoleRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="#0B0E14">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NARUTO STORM CONSOLE"
                android:textColor="#FF6B00"
                android:textStyle="bold"
                android:textSize="20sp"/>
            <TextView
                android:id="@+id/btnConsoleGear"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|top"
                android:gravity="center"
                android:text="⚙"
                android:textColor="#00D4FF"
                android:textSize="26sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Pengaturan lanjutan"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#141923"
            android:padding="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GAME LIBRARY"
                android:textColor="#00D4FF"
                android:textStyle="bold"
                android:textSize="15sp"/>
            <TextView
                android:id="@+id/txtConsoleGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NSUNSR.exe belum ditemukan"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"/>
            <Button
                android:id="@+id/btnConsolePick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PILIH GAME (.EXE)"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF6B00"/>
            <Button
                android:id="@+id/btnConsolePlay"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="16dp"
                android:text="MAIN SEKARANG"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textColor="#0B0E14"
                android:backgroundTint="#00D4FF"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUICK SETTINGS • TAP TO SWITCH"
            android:textColor="#FF6B00"
            android:textStyle="bold"
            android:paddingBottom="8dp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnConsoleResolution" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="960x544" android:textSize="12sp" android:backgroundTint="#141923" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnConsoleDxvk" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="DXVK 1.11" android:textSize="12sp" android:backgroundTint="#141923" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnConsoleFps" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="30 FPS" android:textSize="12sp" android:backgroundTint="#141923" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnConsoleControls" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Kontrol ON" android:textSize="12sp" android:backgroundTint="#141923" android:textColor="#FFFFFF"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/FLFragmentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/NavigationView"
        android:layout_width="272dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="#141923"
        android:theme="@style/ThemeOverlay.Winlator.Drawer"
        app:headerLayout="@layout/main_menu_header"
        app:itemShapeInsetStart="12dp"
        app:itemShapeInsetEnd="12dp"
        app:itemShapeInsetTop="2dp"
        app:itemShapeInsetBottom="2dp"
        app:itemHorizontalPadding="18dp"
        app:itemIconPadding="16dp"
        app:itemIconSize="22dp"
        app:itemTextAppearance="@style/TextAppearance.Winlator.DrawerItem"
        app:itemMaxLines="1"
        app:menu="@menu/main_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>