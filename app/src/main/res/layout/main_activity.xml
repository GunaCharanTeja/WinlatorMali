<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/DrawerLayout"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:id="@+id/Toolbar"
            android:background="?attr/gamingToolbarColor"
            android:elevation="0dp"
            app:layout_scrollFlags="enterAlways|scroll"
            app:title=""
            app:titleTextColor="#ffffff"
            app:titleTextAppearance="@style/TextAppearance.Winlator.Toolbar.Title" />

        <FrameLayout
            android:id="@+id/FLFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"/>

        <!-- Button hints, shown only while a game controller is connected (see ControllerNavigation). -->
        <HorizontalScrollView
            android:id="@+id/HSVControllerHints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/gamingToolbarColor"
            android:scrollbars="none"
            android:focusable="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/LLControllerHints"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:layout_width="272dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:id="@+id/NavigationView"
        android:fitsSystemWindows="true"
        android:background="?attr/semanticSurface"
        android:theme="@style/ThemeOverlay.Winlator.Drawer"
        app:headerLayout="@layout/main_menu_header"
        app:itemShapeInsetStart="12dp"
        app:itemShapeInsetEnd="12dp"
        app:itemShapeInsetTop="2dp"
        app:itemShapeInsetBottom="2dp"
        app:itemHorizontalPadding="18dp"
        app:itemIconPadding="16dp"
        app:itemIconSize="22dp"
        app:itemTextAppearance="@style/TextAppearance.Winlator.DrawerItem"
        app:itemMaxLines="1"
        app:menu="@menu/main_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>