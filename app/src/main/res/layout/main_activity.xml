<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/DrawerLayout" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B0E14">
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:id="@+id/consoleRoot" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:padding="8dp" android:background="#0B0E14">
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="NARUTO STORM CONSOLE" android:textColor="#FF6B00" android:textSize="18sp" android:textStyle="bold"
                    android:maxLines="1" android:ellipsize="end"/>
                <TextView android:id="@+id/txtConsoleRuntimeStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp" android:paddingHorizontal="10dp" android:paddingVertical="6dp"
                    android:background="@drawable/console_status_background" android:text="RUNTIME • MEMERIKSA"
                    android:textColor="#00D4FF" android:textSize="10sp" android:textStyle="bold" android:maxLines="1"
                    android:clickable="true" android:focusable="true" android:contentDescription="Buka Runtime Manager"/>
                <TextView android:id="@+id/btnConsoleDiagnostics" android:layout_width="38dp" android:layout_height="38dp"
                    android:layout_marginEnd="4dp" android:gravity="center" android:background="@drawable/console_status_background"
                    android:text="LOG" android:textColor="#00D4FF" android:textSize="10sp" android:textStyle="bold"
                    android:clickable="true" android:focusable="true" android:contentDescription="Buka Diagnostics dan Log"/>
                <TextView android:id="@+id/btnConsoleGear" android:layout_width="42dp" android:layout_height="42dp" android:gravity="center"
                    android:text="⚙" android:textColor="#00D4FF" android:textSize="25sp" android:clickable="true" android:focusable="true"
                    android:contentDescription="Pengaturan lanjutan"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:orientation="horizontal" android:baselineAligned="false" android:paddingTop="4dp" android:paddingBottom="2dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="52"
                    android:orientation="vertical" android:paddingEnd="6dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp"
                        android:background="@drawable/console_card_background">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="GAME LIBRARY"
                            android:textColor="#00D4FF" android:textSize="12sp" android:textStyle="bold"/>
                        <TextView android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="5dp"
                            android:background="@drawable/console_game_banner" android:gravity="center" android:text="忍 • STORM CONSOLE"
                            android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/>
                        <TextView android:id="@+id/txtConsoleGame" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="NSUNSR.exe belum dipilih" android:textColor="#FFFFFF"
                            android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="middle"/>
                        <TextView android:id="@+id/txtConsoleGamePath" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="2dp" android:text="Pilih folder game dari penyimpanan internal" android:textColor="#AAB6C7"
                            android:textSize="9sp" android:maxLines="1" android:ellipsize="middle"/>
                        <TextView android:id="@+id/txtConsoleGameStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" android:text="● RUNTIME SEDANG DISIAPKAN" android:textColor="#FFB36B"
                            android:textSize="10sp" android:textStyle="bold" android:maxLines="1"/>
                        <ProgressBar android:id="@+id/progressConsoleRuntime" style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="3dp"
                            android:indeterminate="true" android:indeterminateTint="#00D4FF" android:visibility="gone"/>
                    </LinearLayout>
                    <Button android:id="@+id/btnConsolePick" android:layout_width="match_parent" android:layout_height="40dp"
                        android:layout_marginTop="5dp" android:text="PILIH GAME (.EXE)" android:textColor="#FFFFFF" android:textSize="12sp"
                        android:textStyle="bold" android:backgroundTint="#283344"/>
                    <Button android:id="@+id/btnConsolePlay" android:layout_width="match_parent" android:layout_height="50dp"
                        android:layout_marginTop="5dp" android:text="▶ MAIN SEKARANG" android:textColor="#0B0E14"
                        android:textSize="17sp" android:textStyle="bold" android:backgroundTint="#FF6B00"/>
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="48"
                    android:orientation="vertical" android:paddingStart="6dp">
                    <TextView android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical"
                        android:text="PENGATURAN CEPAT" android:textColor="#FF6B00" android:textSize="12sp" android:textStyle="bold"/>
                    <Button android:id="@+id/btnConsoleResolution" android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:layout_marginBottom="3dp" android:minHeight="0dp" android:text="RESOLUSI : 960x544"
                        android:textColor="#FFFFFF" android:textSize="12sp" android:backgroundTint="#141923"/>
                    <Button android:id="@+id/btnConsoleDxvk" android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:layout_marginBottom="5dp" android:minHeight="0dp" android:text="DXVK : 1.11"
                        android:textColor="#FFFFFF" android:textSize="12sp" android:backgroundTint="#141923"/>
                    <Button android:id="@+id/btnConsoleFps" android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:layout_marginBottom="5dp" android:minHeight="0dp" android:text="TARGET : 30 FPS"
                        android:textColor="#FFFFFF" android:textSize="12sp" android:backgroundTint="#141923"/>
                    <Button android:id="@+id/btnConsoleCpu" android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:layout_marginBottom="5dp" android:minHeight="0dp" android:text="MODE CPU : Adem (4 Core)"
                        android:textColor="#FFFFFF" android:textSize="12sp" android:backgroundTint="#141923"/>
                    <Button android:id="@+id/btnConsoleControls" android:layout_width="match_parent" android:layout_height="0dp"
                        android:layout_weight="1" android:minHeight="0dp" android:text="HUD LAYAR : ON" android:textColor="#FFFFFF"
                        android:textSize="12sp" android:backgroundTint="#141923"/>
                </LinearLayout>
            </LinearLayout>
            <HorizontalScrollView android:id="@+id/HSVControllerHints" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:visibility="gone" android:fillViewport="false" android:scrollbars="none">
                <LinearLayout android:id="@+id/LLControllerHints" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"/>
            </HorizontalScrollView>
        </LinearLayout>
        <FrameLayout android:id="@+id/FLFragmentContainer" android:layout_width="match_parent" android:layout_height="match_parent"
            android:visibility="gone" android:background="#0B0E14"/>
    </FrameLayout>
    <com.google.android.material.navigation.NavigationView android:id="@+id/NavigationView" android:layout_width="272dp"
        android:layout_height="match_parent" android:layout_gravity="start" android:fitsSystemWindows="true"
        android:background="#141923" android:theme="@style/ThemeOverlay.Winlator.Drawer"
        app:headerLayout="@layout/main_menu_header" app:itemShapeInsetStart="12dp" app:itemShapeInsetEnd="12dp"
        app:itemShapeInsetTop="2dp" app:itemShapeInsetBottom="2dp" app:itemHorizontalPadding="18dp" app:itemIconPadding="16dp"
        app:itemIconSize="22dp" app:itemTextAppearance="@style/TextAppearance.Winlator.DrawerItem"
        app:itemMaxLines="1" app:menu="@menu/main_menu"/>
</androidx.drawerlayout.widget.DrawerLayout>