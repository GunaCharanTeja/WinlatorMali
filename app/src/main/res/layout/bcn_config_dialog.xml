<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="220dp"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- Header / Emulation Mode -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/graphics_driver_bcn_emulation"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary" />

            <ImageView
                android:id="@+id/IVTranscodeInfo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_driver_info"
                app:tint="?android:attr/textColorSecondary"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:contentDescription="Info" />
        </LinearLayout>

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:id="@+id/SGraphicsDriverBCnEmulation"
            android:entries="@array/bcn_emulation_entries"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="10dp" />

        <!-- Emulation Type -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/graphics_driver_bcn_emulation_type"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:id="@+id/SGraphicsDriverBCnEmulationType"
            android:entries="@array/bcn_emulation_type_entries"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="10dp" />

        <!-- Emulation Cache -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/graphics_driver_bcn_emulation_cache"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:id="@+id/SGraphicsDriverBCnEmulationCache"
            android:entries="@array/bcn_emulation_cache_entries"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="10dp" />

        <!-- Quality Preset -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/graphics_driver_bcn_quality_preset"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?android:attr/textColorSecondary" />

            <ImageView
                android:id="@+id/IVQualityPresetInfo"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_driver_info"
                app:tint="?android:attr/textColorSecondary"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:contentDescription="Info" />
        </LinearLayout>

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:id="@+id/SGraphicsDriverBCnQualityPreset"
            android:entries="@array/bcn_quality_preset_entries"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="12dp" />

        <!-- Options Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bordered_panel_dark"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/CBASTCTranscode"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="@string/graphics_driver_astc_transcode"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/CBETC2Transcode"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="@string/graphics_driver_etc2_transcode"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#20FFFFFF"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <CheckBox
                android:id="@+id/CBSkipSmallTextures"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="@string/graphics_driver_bcn_skip_small_textures"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>