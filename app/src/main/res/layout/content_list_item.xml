<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="6dp"
    android:paddingTop="9dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/IVIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/icon_wine"
            app:tint="?attr/colorAccent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Full name over up to two lines: the version and architecture sit at its end. -->
            <TextView
                android:id="@+id/TVVersionName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="14.5sp"
                android:fontFamily="sans-serif-medium"
                android:ellipsize="end"
                android:maxLines="2" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Architecture chip (x86_64 / arm64ec / x86), colored from the theme accent. -->
                <TextView
                    android:id="@+id/TVArchChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.04"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/TVVersionCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="12sp"
                    android:ellipsize="end"
                    android:maxLines="2" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/BTMenu"
            style="@style/ListMenuButton"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="4dp"
            android:padding="5dp"
            app:tint="?attr/colorAccent"
            android:src="@drawable/icon_list_item_menu" />

        <ImageButton
            android:id="@+id/BTDownload"
            style="@style/ListMenuButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="7dp"
            app:tint="?attr/colorAccent"
            android:src="@drawable/icon_download"
            android:contentDescription="Download Component" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/LLDownloadProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/HorizontalProgressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/custom_progress_bar" />

        <TextView
            android:id="@+id/TVProgressDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            android:layout_marginTop="3dp"
            android:gravity="end"
            android:text="0%" />
    </LinearLayout>

</LinearLayout>
