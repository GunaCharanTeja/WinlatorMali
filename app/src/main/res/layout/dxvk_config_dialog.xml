<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="220dp"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- VKD3D Version -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vkd3d_version"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:id="@+id/SVKD3DVersion"
            android:entries="@array/vkd3d_version_entries"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="10dp" />

        <!-- VKD3D Feature Level -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vkd3d_feature_level"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:id="@+id/SVKD3DFeatureLevel"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="10dp" />

        <!-- DXVK Version -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dxvk_version"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:id="@+id/SDXVKVersion"
            android:entries="@array/dxvk_version_entries"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="10dp" />

        <!-- Async Toggle -->
        <LinearLayout
            android:id="@+id/LLAsync"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bordered_panel_dark"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:text="@string/enabled_async" />

            <ToggleButton
                android:id="@+id/SWAsync"
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:background="@drawable/toggle_button_selector"
                android:textOn=""
                android:textOff="" />
        </LinearLayout>

        <!-- Async Cache Toggle -->
        <LinearLayout
            android:id="@+id/LLAsyncCache"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bordered_panel_dark"
            android:layout_marginBottom="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:text="@string/enabled_async_cache" />

            <ToggleButton
                android:id="@+id/SWAsyncCache"
                android:layout_width="56dp"
                android:layout_height="30dp"
                android:background="@drawable/toggle_button_selector"
                android:textOn=""
                android:textOff="" />
        </LinearLayout>

        <!-- DDraw Wrapper -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ddraw_wrapper"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:id="@+id/SDDRAWrapper"
            android:entries="@array/ddrawrapper_entries"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="10dp" />

        <!-- Max Device Memory -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/max_device_memory"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="4dp" />

        <Spinner
            style="@style/ComboBox"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:id="@+id/SMaxDeviceMemory"
            android:entries="@array/dxvk_max_device_memory_entries"
            android:spinnerMode="dropdown"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>