<?xml version="1.0" encoding="utf-8"?>
<!-- Fullscreen mode and screen alignment pickers, shared by container and shortcut settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="4dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/fullscreen_mode"
            android:textSize="13sp" />

        <Spinner
            style="@style/ComboBox"
            android:id="@+id/SFullscreenMode"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:entries="@array/fullscreen_mode_entries" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="6dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screen_alignment"
            android:textSize="13sp" />

        <Spinner
            style="@style/ComboBox"
            android:id="@+id/SScreenAlignment"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:entries="@array/screen_alignment_entries" />
    </LinearLayout>
</LinearLayout>
