<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="4dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bordered_panel">

    <ImageView
        android:id="@+id/IVIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_graphics_management"
        app:tint="@color/colorPrimaryDark" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/TVName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/TVVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/BTInfo"
        style="@style/ListMenuButton"
        android:src="@drawable/ic_driver_info"
        android:contentDescription="Info" />

    <ImageButton
        android:id="@+id/BTUpdate"
        style="@style/ListMenuButton"
        android:src="@drawable/ic_driver_update"
        android:contentDescription="Update" />

    <ImageButton
        android:id="@+id/BTRemove"
        style="@style/ListMenuButton"
        android:src="@drawable/ic_driver_reset"
        android:contentDescription="Reset" />

</LinearLayout>
