<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bordered_panel_dark">

    <ImageView
        android:id="@+id/IVIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginEnd="12dp"
        android:src="@drawable/ic_graphics_management"
        app:tint="?attr/colorAccent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/TVName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/TVVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/BTInfo"
        style="@style/ListMenuButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:padding="6dp"
        app:tint="?attr/colorAccent"
        android:src="@drawable/ic_driver_info"
        android:contentDescription="Info" />

    <ImageButton
        android:id="@+id/BTUpdate"
        style="@style/ListMenuButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:padding="6dp"
        app:tint="?attr/colorAccent"
        android:src="@drawable/ic_driver_update"
        android:contentDescription="Update" />

    <ImageButton
        android:id="@+id/BTRemove"
        style="@style/ListMenuButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:padding="6dp"
        app:tint="?attr/colorAccent"
        android:src="@drawable/ic_driver_reset"
        android:contentDescription="Reset" />

</LinearLayout>
