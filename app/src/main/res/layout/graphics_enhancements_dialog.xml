<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:layout_width="340dp"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- Universal FPS Limiter Section -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1.0"
                    android:layout_height="wrap_content"
                    android:text="Universal FPS Limiter"
                    android:textStyle="bold"
                    android:textSize="14sp" />
                <ImageView
                    android:id="@+id/IVFPSLimitInfo"
                    android:layout_width="32.0dip"
                    android:layout_height="32.0dip"
                    android:padding="4.0dip"
                    android:src="@drawable/ic_driver_info"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Info"
                    app:tint="#ff9e9e9e" />
            </LinearLayout>
            <TextView
                android:textSize="11.0sp"
                android:textColor="#ff9e9e9e"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="High-precision throttling for consistent frame pacing."
                android:layout_marginBottom="4dp" />
            <Spinner
                android:id="@+id/SFPSLimit"
                android:entries="@array/fps_limit_entries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:spinnerMode="dialog" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ff424242"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Apex LSFG Section -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <CheckBox
                    android:id="@+id/CBEnableLSFG"
                    android:layout_width="0.0dip"
                    android:layout_weight="1.0"
                    android:layout_height="wrap_content"
                    android:text="@string/enable_lsfg"
                    android:textStyle="bold"
                    android:textSize="14sp" />
                <ImageView
                    android:id="@+id/IVLSFGInfo"
                    android:layout_width="32.0dip"
                    android:layout_height="32.0dip"
                    android:padding="4.0dip"
                    android:src="@drawable/ic_driver_info"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Info"
                    app:tint="#ff9e9e9e" />
            </LinearLayout>
            <TextView
                android:textSize="11.0sp"
                android:textColor="#ff9e9e9e"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lsfg_description"
                android:layout_marginBottom="4dp" />
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/LLLSFGSettings"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:textSize="12sp"
                    android:text="@string/lsfg_quality" />
                <Spinner
                    android:id="@+id/SLSFGQuality"
                    android:entries="@array/lsfg_quality_entries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dialog" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:textSize="12sp"
                    android:text="Target FPS" />
                <Spinner
                    android:id="@+id/SLSFGTargetFPS"
                    android:entries="@array/lsfg_target_fps_entries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dialog" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:textSize="12sp"
                    android:text="@string/motion_blur" />
                <com.winlator.cmod.widget.SeekBar
                    android:id="@+id/SBLSFGMotionBlur"
                    android:layout_width="match_parent"
                    android:layout_height="60.0dip"
                    app:sbMaxValue="1.0"
                    app:sbMinValue="0.0"
                    app:sbStep="0.01" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ff424242"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- HDR Section -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">
            <CheckBox
                android:id="@+id/CBEnableHDR"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Fake HDR"
                android:textStyle="bold"
                android:textSize="14sp" />
            <TextView
                android:textSize="11.0sp"
                android:textColor="#ff9e9e9e"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Applies a dual-radius bloom blur and contrast boost." />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#ff424242"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Sharpening Section -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp">
            <CheckBox
                android:id="@+id/CBEnableSharpen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enable Sharpening (CAS)"
                android:textStyle="bold"
                android:textSize="14sp" />
            <TextView
                android:textSize="11.0sp"
                android:textColor="#ff9e9e9e"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contrast Adaptive Sharpening (CAS) resolves blurriness." />
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/LLSharpenSettings"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:textSize="12sp"
                    android:text="Sharpening Mode" />
                <Spinner
                    android:id="@+id/SSharpenMode"
                    android:entries="@array/sharpening_mode_entries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dialog" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8.0dip"
                    android:textSize="12sp"
                    android:text="Sharpening Level" />
                <com.winlator.cmod.widget.SeekBar
                    android:id="@+id/SBSharpenLevel"
                    android:layout_width="match_parent"
                    android:layout_height="60.0dip"
                    app:sbMaxValue="5.0"
                    app:sbMinValue="1.0"
                    app:sbStep="1.0" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer at bottom to ensure last spinner doesn't get cut off -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>
